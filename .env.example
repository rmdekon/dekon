# ─────────────────────────────────────────────────────────────
# DEKON settings. Copy to ".env" and fill in.
# Local runs (no TURSO_* vars) use Node's built-in SQLite file
# in the data/ folder. For deployment, add the TURSO_* values.
# ─────────────────────────────────────────────────────────────

# Used to sign login JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Port the app listens on
PORT=3000

# Public base URL (no trailing slash).
# Local:  http://localhost:3000
# Online: https://dekon-finance.onrender.com
APP_URL=http://localhost:3000

# --- Cloud database (Turso) — required for online hosting ---
# Create a free DB at https://turso.tech and paste the two values:
#   TURSO_DATABASE_URL=libsql://your-db-name.turso.io
#   TURSO_AUTH_TOKEN=eyJ...   (create a non-expiring token)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Google Sign-In (optional) ---
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
