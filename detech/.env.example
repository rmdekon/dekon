# ──────────────────────────────────────────────────────────────
#  DETECH — School Management System
#
#  Copy this file to ".env" before running the app:
#      cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ---------- Database ----------
# DEV (default, zero setup): a local SQLite file created in this folder.
DATABASE_URL="file:./dev.db"

# PRODUCTION options:
#   Turso / libSQL (works with the current driver, no code change):
#     DATABASE_URL="libsql://your-db.turso.io"
#     DATABASE_AUTH_TOKEN="your-token"
#
#   PostgreSQL — change the dialect in src/db/schema.ts + src/db/index.ts
#   (see "Switching to PostgreSQL" in INSTALL.md), then:
#     DATABASE_URL="postgresql://detech:detech@localhost:5432/detech"
DATABASE_AUTH_TOKEN=""

# ---------- Auth ----------
# Secret used to sign session JWTs. MUST be changed for production.
# Generate one with:   openssl rand -base64 48
AUTH_SECRET="dev-only-secret-change-me-to-a-long-random-string-please"

# Session lifetime in seconds (default = 7 days)
SESSION_MAX_AGE=604800

# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# ISO-4217 code used by every money figure in the UI (e.g. USD, GHS, NGN, EUR)
NEXT_PUBLIC_CURRENCY="USD"

# ---------- Optional integrations ----------
# Every feature below degrades gracefully when the keys are absent.

# Redis — caching & session revocation
# REDIS_URL="redis://localhost:6379"

# Email (SendGrid or any SMTP provider)
# SENDGRID_API_KEY=""
# MAIL_FROM="no-reply@detech.school"

# SMS (Twilio)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# Payments (Stripe)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Error tracking (Sentry)
# SENTRY_DSN=""
